{
  "name": "sartor",
  "version": "0.1.0",
  "description": "Resume tailoring primitives with a structural anti-fabrication guard. BYOK, browser-first, no backend.",
  "license": "MIT",
  "author": "Tristan Heilman",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tristanheilman/sartor.git"
  },
  "homepage": "https://github.com/tristanheilman/sartor#readme",
  "bugs": {
    "url": "https://github.com/tristanheilman/sartor/issues"
  },
  "keywords": [
    "resume-builder",
    "resume-tailoring",
    "bring-your-own-key",
    "ats-resume",
    "job-search",
    "llm",
    "hallucination",
    "grounding",
    "json-resume"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./parse": {
      "types": "./dist/parse.d.ts",
      "import": "./dist/parse.js"
    },
    "./render/pdf": {
      "types": "./dist/render/pdf.d.ts",
      "import": "./dist/render/pdf.js"
    },
    "./render/docx": {
      "types": "./dist/render/docx.d.ts",
      "import": "./dist/render/docx.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:lib && npm run build:app",
    "build:lib": "tsup && npm run build:types",
    "build:app": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build:lib",
    "build:types": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "@react-pdf/renderer": "^4.5.1",
    "docx": "^9.7.1",
    "pdfjs-dist": "^5.6.205",
    "mammoth": "^1.12.0",
    "@anthropic-ai/sdk": "^0.115.0",
    "openai": "^6.49.0",
    "@google/genai": "^2.15.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "@react-pdf/renderer": {
      "optional": true
    },
    "docx": {
      "optional": true
    },
    "pdfjs-dist": {
      "optional": true
    },
    "mammoth": {
      "optional": true
    },
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "openai": {
      "optional": true
    },
    "@google/genai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@google/genai": "^2.15.0",
    "@react-pdf/renderer": "^4.5.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/file-saver": "^2.0.7",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "docx": "^9.7.1",
    "fake-indexeddb": "^6.2.5",
    "file-saver": "^2.0.5",
    "idb": "^8.0.3",
    "jsdom": "^29.1.1",
    "mammoth": "^1.12.0",
    "openai": "^6.49.0",
    "pdfjs-dist": "^5.6.205",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
