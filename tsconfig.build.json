{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationMap": true,
    "outDir": "dist",
    "rootDir": "src",
    // The app's ambient Vite types are irrelevant to consumers of the library,
    // and pulling them in would leak `import.meta.env` into published .d.ts.
    "types": []
  },
  // Only the published entry points. tsc follows their imports, so
  // `src/ui` and `src/storage` are never reached and never emitted.
  "include": ["src/index.ts", "src/parse.ts", "src/render/pdf.ts", "src/render/docx.ts"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
